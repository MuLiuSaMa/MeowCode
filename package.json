{
  "name": "meowcode",
  "version": "1.2.1",
  "private": true,
  "author": { "name": "MuLiuSaMa" },
  "type": "module",
  "license": "GPL-3.0-or-later",
  "main": "dist/server/server.js",
  "files": ["dist"],
  "scripts": {
    "build:agent": "tsc -p tsconfig.json",
    "dev:server": "tsx watch src/server/server.ts",
    "start:server": "node dist/server/server.js",
    "dev:desktop": "pnpm --filter @meowcode/desktop dev",
    "brand:dev": "node scripts/brand-electron.mjs",
    "make:ico": "node scripts/make-meowcode-ico.mjs",
    "build": "pnpm build:agent && pnpm --filter @meowcode/desktop build",
    "test": "vitest run",
    "test:release": "node scripts/release-smoke.mjs",
    "package": "pnpm build && pnpm --filter @meowcode/desktop package:win",
    "package:msix": "pnpm build && pnpm --filter @meowcode/desktop package:msix",
    "make:msix-assets": "node scripts/make-msix-assets.mjs",
    "test:msix": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/msix-test-sign.ps1",
    "test:msix:sign": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/msix-test-sign.ps1 -NoInstall",
    "test:msix:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/msix-test-sign.ps1 -Uninstall",
    "lint": "oxlint src desktop/src",
    "lint:fix": "oxlint --fix src desktop/src"
  },
  "dependencies": {
    "@joplin/turndown-plugin-gfm": "^1.0.68",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@vscode/ripgrep": "^1.18.0",
    "jiti": "^2.7.0",
    "koffi": "3.1.1",
    "pdfjs-dist": "^6.4.299",
    "smol-toml": "^1.9.1",
    "turndown": "^7.2.4",
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/turndown": "^5.0.6",
    "@vscode/ripgrep-win32-x64": "1.18.0",
    "oxlint": "^1.90.0",
    "png-to-ico": "^3.0.2",
    "resedit": "^3.1.0",
    "simple-icons": "^16.35.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
