#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
SYSTEM=$(uname -s)
MACHINE=$(uname -m)

case "${SYSTEM}:${MACHINE}" in
  Darwin:arm64|Darwin:aarch64)
    PLATFORM="darwin-arm64"
    ;;
  Darwin:x86_64)
    PLATFORM="darwin-x64"
    ;;
  Linux:arm64|Linux:aarch64)
    PLATFORM="linux-arm64"
    ;;
  Linux:x86_64|Linux:amd64)
    PLATFORM="linux-x64"
    ;;
  *)
    printf '%s\n' '{"ok":false,"error":{"code":"UNSUPPORTED_PLATFORM","message":"trae-deploy is not available for this platform","retryable":false,"details":{}},"request_id":null}'
    exit 2
    ;;
esac

BINARY="${SCRIPT_DIR}/../bin/${PLATFORM}/trae-deploy"
if [ ! -f "${BINARY}" ]; then
  printf '%s\n' '{"ok":false,"error":{"code":"CLI_BINARY_MISSING","message":"trae-deploy binary is missing from the plugin package","retryable":false,"details":{}},"request_id":null}'
  exit 2
fi
if [ ! -x "${BINARY}" ]; then
  chmod 0755 "${BINARY}" 2>/dev/null || true
fi
if [ ! -x "${BINARY}" ]; then
  printf '%s\n' '{"ok":false,"error":{"code":"CLI_BINARY_NOT_EXECUTABLE","message":"trae-deploy binary is not executable","retryable":false,"details":{}},"request_id":null}'
  exit 2
fi

exec "${BINARY}" "$@"
